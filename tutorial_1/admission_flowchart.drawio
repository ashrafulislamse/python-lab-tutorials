<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="start" value="Start" style="ellipse;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;" vertex="1" parent="1">
      <mxGeometry x="300" y="20" width="120" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="input" value="Read age,&#10;accompanied (yes/no),&#10;valid ticket (yes/no)" style="shape=parallelogram;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="260" y="110" width="200" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="d1" value="Has a valid&#10;ticket?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="270" y="220" width="180" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="d2" value="Age 13 or older&#10;OR with an adult?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="270" y="350" width="180" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="allow" value="Allowed to enter" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="560" y="365" width="170" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="deny" value="Not allowed to enter" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="20" y="265" width="180" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="end" value="End" style="ellipse;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;" vertex="1" parent="1">
      <mxGeometry x="300" y="510" width="120" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2.5;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="start" target="input">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2.5;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="input" target="d1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e3" value="No" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2.5;html=1;fontSize=15;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="d1" target="deny">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e4" value="Yes" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2.5;html=1;fontSize=15;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d1" target="d2">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e5" value="Yes" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2.5;html=1;fontSize=15;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d2" target="allow">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e6" value="No" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2.5;html=1;fontSize=15;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="d2" target="deny">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2.5;html=1;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="allow" target="end">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2.5;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="deny" target="end">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
